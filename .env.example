# Copy to .env locally or create a separate .env on the EC2 instance.
# Replace placeholder values before starting Django or Gunicorn.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-ec2-dns-name,your-domain.example
CORS_ALLOWED_ORIGINS=https://your-frontend.example
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Set a positive value only after HTTPS is working correctly on the domain.
SECURE_HSTS_SECONDS=0
